# --- Dependencies ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Build output ---
frontend/dist/
frontend/build/

# --- Environment variables (NEVER commit real secrets) ---
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# --- Logs ---
backend/logs/*
!backend/logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Uploaded user files (runtime data, not source code) ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- Editor / OS junk ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Misc ---
*.local
